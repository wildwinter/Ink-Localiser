<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>0.0.1.1</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>wildwinter.LocaliserLib</PackageId>
    <Authors>Ian Thomas</Authors>
    <Copyright>Copyright © 2024 Ian Thomas</Copyright>
    <Description>
      Library for adding localisation IDs to Inkle Ink files and exporting strings
      as JSON, CSV, or PO/POT. Scans .ink files for lines of text, tags each line
      with a unique stable ID, and exports the resulting string table for use in
      localisation pipelines or audio triggering.

      Requires ink_compiler.dll and ink-engine-runtime.dll from an inklecate
      release (https://github.com/inkle/ink/releases) to be referenced in your
      project separately.
    </Description>
    <PackageTags>ink;inkle;localisation;localization;narrative;game-dev;interactive-fiction;po;gettext</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/wildwinter/Ink-Localiser</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wildwinter/Ink-Localiser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ink_compiler">
      <HintPath>../Lib/Inklecate/ink_compiler.dll</HintPath>
    </Reference>
    <Reference Include="ink-engine-runtime">
      <HintPath>../Lib/Inklecate/ink-engine-runtime.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="wildwinter.SimpleVCLib" Version="0.0.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md"
          Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
